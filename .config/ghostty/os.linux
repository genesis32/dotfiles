# Linux/GTK-only settings. Linked to ~/.config/ghostty/os.conf by install.sh.

# Client-side decorations (GTK); macOS uses native decorations.
window-decoration = client

keybind = alt+s=new_split:right
keybind = alt+shift+s=new_split:down

keybind = alt+t=new_tab

keybind = alt+bracket_right=goto_split:next
keybind = alt+bracket_left=goto_split:previous
# keybind = global:ctrl+grave_accent=toggle_quick_terminal
