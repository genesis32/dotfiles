{
  "auto_update": false,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "plan",
        "effort": "medium",
        "fast": "off"
      },
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right"
  },
  "project_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "mode": "eager"
  },
  "double_click_in_multibuffer": "open",
  "relative_line_numbers": "enabled",
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "theme": {
    "mode": "dark",
    "light": "Nightfox - opaque",
    "dark": "Nightfox - opaque"
  }
}
