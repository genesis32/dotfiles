[
  {
    "bindings": {
      "f1": "project_panel::ToggleFocus",
      "f2": "git_panel::ToggleFocus",
      "f3": "editor::ToggleFocus",
      "f4": "agent::FocusAgent",
      "f5": "agents_sidebar::ToggleThreadSwitcher"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "f10": "debugger::StepOver",
      "f11": "debugger::StepInto"
    }
  },
  {
    "context": "VimControl && !menu && vim_mode == normal",
    "bindings": {
      "shift shift": "file_finder::Toggle",

      "space p a": "workspace::ToggleAllDocks",
      "space p b": "workspace::ToggleBottomDock",
      "space p h": "workspace::ToggleLeftDock",
      "space p l": "workspace::ToggleRightDock",

      "space g r": "editor::FindAllReferences",
      "space g d": "editor::GoToDefinition",
      "space g v": "editor::GoToDefinitionSplit",

      "space f g": "workspace::NewSearch",
      "space f f": "file_finder::Toggle"
    }
  }
]
